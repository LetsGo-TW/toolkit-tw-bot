{
  "name": "toolkit-tw-monorepo",
  "private": true,
  "packageManager": "yarn@4.11.0",
  "engines": {
    "node": ">=20 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k --names api,cdn,extension --prefix-colors blue,magenta,green \"yarn dev:api\" \"yarn dev:cdn\" \"yarn dev:extension\"",
    "dev:api": "yarn workspace @toolkit-tw-bot/api dev",
    "dev:cdn": "yarn workspace @toolkit-tw-bot/cdn dev",
    "dev:extension": "yarn workspace @toolkit-tw-bot/extension dev",
    "start": "yarn workspace @toolkit-tw-bot/api start",
    "build": "node -e \"console.log('No build step required for current workspaces.')\"",
    "build:assets": "bash ./scripts/build-assets.sh",
    "build:assets:dev": "bash ./scripts/build-assets.sh --env=dev",
    "build:assets:prod-local": "bash ./scripts/build-assets.sh --env=prod-local",
    "build:assets:prod": "bash ./scripts/build-assets.sh --env=prod",
    "publish:cdn": "bash ./scripts/publish-cdn.sh",
    "zip:extension": "bash ./apps/extension/generate-extension-zip.sh",
    "backup:players": "yarn workspace @toolkit-tw-bot/ops backup:players",
    "db:dev:up": "docker compose up -d mongo",
    "db:dev:down": "docker compose down",
    "db:dev:logs": "docker compose logs -f mongo",
    "db:dev:up:restore": "docker compose up -d mongo && yarn db:dev:restore:players:latest",
    "db:dev:restore:players:latest": "yarn workspace @toolkit-tw-bot/ops restore:players:latest",
    "db:inspect": "yarn workspace @toolkit-tw-bot/ops db:inspect",
    "db:check:id": "yarn workspace @toolkit-tw-bot/ops db:check:id",
    "db:cleanup:duplicates": "yarn workspace @toolkit-tw-bot/ops db:cleanup:duplicates",
    "db:cleanup:expired": "yarn workspace @toolkit-tw-bot/ops db:cleanup:expired",
    "db:data:scan:expired": "yarn workspace @toolkit-tw-bot/ops db:data:scan:expired",
    "db:data:scan:month": "yarn workspace @toolkit-tw-bot/ops db:data:scan:month",
    "db:data:search:id": "yarn workspace @toolkit-tw-bot/ops db:data:search:id",
    "db:restore:data-file": "yarn workspace @toolkit-tw-bot/ops db:restore:data-file"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "@types/uuid": "^11.0.0",
    "concurrently": "^9.2.1"
  }
}
