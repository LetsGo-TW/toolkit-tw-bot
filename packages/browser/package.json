{
  "name": "@toolkit-tw-bot/browser",
  "private": true,
  "version": "1.0.0",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./indexedDb": {
      "types": "./src/indexed-db.d.ts",
      "require": "./src/indexed-db.js",
      "import": "./src/indexed-db.js",
      "default": "./src/indexed-db.js"
    },
    "./makeAjax": {
      "types": "./src/index.d.ts",
      "require": "./src/make-ajax.js",
      "import": "./src/make-ajax.js",
      "default": "./src/make-ajax.js"
    },
    "./combineAbortControllerSignals": {
      "types": "./src/index.d.ts",
      "require": "./src/combine-abort-controller-signals.js",
      "import": "./src/combine-abort-controller-signals.js",
      "default": "./src/combine-abort-controller-signals.js"
    }
  },
  "typesVersions": {
    "*": {
      "indexedDb": [
        "src/indexed-db.d.ts"
      ],
      "makeAjax": [
        "src/index.d.ts"
      ],
      "combineAbortControllerSignals": [
        "src/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=20 <23"
  }
}
