{
  "name": "@toolkit-tw-bot/cdn",
  "version": "2.0.0",
  "private": true,
  "description": "Build-only CDN bundles for Toolkit TW Bot",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev": "webpack --config webpack/webpack.config.js --env env=dev --watch",
    "prebuild": "yarn generate:dynamic-imports",
    "build:dev": "webpack --config webpack/webpack.config.js --env env=dev",
    "build:prod": "webpack --config webpack/webpack.config.js --env env=prod",
    "build": "yarn build:prod",
    "build:analyze": "ANALYZE=true webpack --config webpack/webpack.config.js --env env=prod",
    "build:obfuscate:default": "OBFUSCATE=true OBFUSCATE_LEVEL=default webpack --config webpack/webpack.config.js --env env=prod",
    "build:obfuscate:low": "OBFUSCATE=true OBFUSCATE_LEVEL=low webpack --config webpack/webpack.config.js --env env=prod",
    "build:obfuscate:medium": "OBFUSCATE=true OBFUSCATE_LEVEL=medium webpack --config webpack/webpack.config.js --env env=prod",
    "generate:dynamic-imports": "node scripts/generate-dynamic-imports.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@toolkit-tw-bot/release": "workspace:*",
    "@toolkit-tw-bot/webpack": "workspace:*",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.1",
    "javascript-obfuscator": "^4.1.1",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.101.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-manifest-plugin": "^5.0.1",
    "webpack-merge": "^6.0.1",
    "webpack-obfuscator": "^3.5.1"
  },
  "dependencies": {
    "@toolkit-tw-bot/browser": "workspace:*",
    "@toolkit-tw-bot/core": "workspace:*",
    "@toolkit-tw-bot/utils": "workspace:*"
  }
}
